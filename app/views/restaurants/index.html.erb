<h1>Restaurants</h1>
<% @restaurants.each do |restaurant| %>
  <div class="card p-3 mb-3">
    <h2><%= restaurant.name %></h2>
    <p><%= restaurant.category.capitalize %> · <%= restaurant.address %></p>
    <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-primary align-self-start" %>
  </div>
<% end %>
