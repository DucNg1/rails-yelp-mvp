<h1><%= @restaurant.name %></h1>
<p><%= @restaurant.category.capitalize %> · <%= @restaurant.address %> · <%= @restaurant.phone_number %></p>

<h2>Reviews</h2>
<% if @restaurant.reviews.any? %>
  <% @restaurant.reviews.each do |review| %>
    <div class="card p-3 mb-2">
      <strong><%= review.rating %>/5</strong>
      <p class="mb-0"><%= review.content %></p>
    </div>
  <% end %>
<% else %>
  <p>No reviews yet.</p>
<% end %>

<h2 class="mt-4">Add a review</h2>
<%= simple_form_for [@restaurant, @review] do |f| %>
  <%= f.input :rating, collection: 0..5, include_blank: false %>
  <%= f.input :content %>
  <%= f.button :submit, class: "btn btn-primary" %>
<% end %>

<%= link_to "Back", restaurants_path, class: "btn btn-outline-secondary btn-sm" %>
